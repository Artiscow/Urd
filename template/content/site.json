{
  "schemaVersion": 2,
  "site": {
    "title": "Urd v0.5",
    "lang": "no",
    "description": "En nettside bygget med Urd"
  },
  "breakpoints": {
    "mobile": 640
  },
  "grid": {
    "size": 16,
    "snap": true
  },
  "theme": {
    "version": 1,
    "tokens": {
      "color": {
        "bg": "#000000",
        "surface": "#000000",
        "text": "#e8eaf0",
        "accent": "#00fff5",
        "accent-text": "#000000"
      },
      "font": {
        "heading": "'Courier New', monospace",
        "body": "Georgia, 'Times New Roman', serif"
      },
      "radius": {
        "sm": "6px",
        "md": "12px"
      },
      "space": {
        "section": "clamp(3rem, 8vw, 6rem)"
      }
    }
  },
  "pages": [
    {
      "id": "hjem",
      "title": "Hjem",
      "path": "/",
      "file": "content/pages/hjem.json"
    },
    {
      "id": "om-oss",
      "title": "Om oss",
      "path": "/om-oss",
      "file": "content/pages/om-oss.json"
    },
    {
      "id": "kontakt",
      "title": "Kontakt",
      "path": "/kontakt",
      "file": "content/pages/kontakt.json"
    },
    {
      "id": "kaker",
      "title": "Kaker",
      "path": "/kaker",
      "file": "content/pages/kaker.json"
    }
  ],
  "nav": {
    "version": 1,
    "logo": {
      "type": "text",
      "value": "Urd v0.6",
      "size": 35,
      "order": "image-first",
      "bold": false,
      "italic": false,
      "font": "'Trebuchet MS', sans-serif",
      "radius": 20
    },
    "items": [
      {
        "label": "Hjem",
        "page": "hjem"
      },
      {
        "label": "Om oss",
        "page": "om-oss"
      },
      {
        "label": "Kontakt",
        "page": "kontakt"
      },
      {
        "label": "Kaker",
        "page": "kaker"
      }
    ],
    "layout": "left",
    "sticky": true
  },
  "footer": {
    "version": 1,
    "show": true,
    "align": "left",
    "brand": {
      "title": "Urd",
      "tagline": "Bygg din egen nettside for din lille forening helt gratis!"
    },
    "columns": [
      {
        "title": "Utforsk",
        "links": [
          {
            "label": "Hjem",
            "page": "hjem"
          },
          {
            "label": "Om oss",
            "page": "om-oss"
          },
          {
            "label": "Kontakt",
            "page": "kontakt"
          },
          {
            "label": "Kaker",
            "page": "kaker"
          }
        ]
      },
      {
        "title": "Følg oss",
        "links": [
          {
            "label": "Vi har ingen steder du kan følge oss",
            "href": "#"
          }
        ]
      }
    ],
    "social": [
      {
        "icon": "facebook",
        "url": "https://facebook.com"
      },
      {
        "icon": "instagram",
        "url": "https://instagram.com"
      },
      {
        "icon": "linkedin",
        "url": "https://linkedin.com"
      },
      {
        "icon": "youtube",
        "url": "https://youtube.com"
      }
    ],
    "background": {
      "version": 1,
      "layers": [
        {
          "type": "glow",
          "version": 1,
          "props": {
            "x": 0.12,
            "y": 0,
            "color": "#00a19b",
            "radius": 0.6,
            "opacity": 0.45
          }
        },
        {
          "type": "grain",
          "version": 1,
          "props": {
            "opacity": 0.08
          }
        }
      ]
    },
    "baseline": [
      {
        "label": "Personvern",
        "href": "#"
      },
      {
        "label": "Laget med Urd",
        "href": "#"
      }
    ],
    "copyright": "© Min forening"
  }
}
